# Dev only (tools/serve.mjs). Muse never reads this file.
# Live timesheet sync in local previews: your timesheet API's base URL and key.
TIMESHEET_API_BASE=
TIMESHEET_API_KEY=
PORT=5174
# The dev server always binds to 127.0.0.1 and only answers Host localhost:PORT / 127.0.0.1:PORT,
# so the key never leaves this machine.
